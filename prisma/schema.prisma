generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { MASTER OWNER }
enum ShopStatus { PENDING ACTIVE SUSPENDED }
enum BookingStatus { CONFIRMED COMPLETED CANCELLED NO_SHOW }
enum PaymentStatus { PENDING PAID }
enum PaymentMethod { AT_SHOP PIX CASH CARD }
enum BookingSource { ONLINE WALK_IN }
model Barbershop {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String @default("")
  logoUrl String @default("")
  coverUrl String @default("")
  accentColor String @default("#2563FF")
  address String @default("")
  whatsapp String @default("")
  instagram String @default("")
  timezone String @default("America/Bahia")
  pixKey String @default("")
  pixEnabled Boolean @default(false)
  payAtShopEnabled Boolean @default(true)
  status ShopStatus @default(PENDING)
  planDays Int @default(30)
  paidThrough DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  professionals Professional[]
  services Service[]
  appointments Appointment[]
  expenses Expense[]
  reviews Review[]
  media Media[]
  audits AuditLog[]
}
model User {
  id String @id @default(cuid())
  username String @unique
  passwordHash String
  role Role @default(OWNER)
  shopId String?
  shop Barbershop? @relation(fields:[shopId],references:[id],onDelete:SetNull)
  sessions Session[]
  logs AuditLog[]
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model Professional {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  name String
  photoUrl String @default("")
  commissionPct Int @default(50)
  active Boolean @default(true)
  hours WorkingHour[]
  bookings Appointment[]
  @@index([shopId])
}
model Service {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  name String
  description String @default("")
  priceCents Int
  durationMinutes Int
  active Boolean @default(true)
  bookings Appointment[]
  @@index([shopId])
}
model WorkingHour {
  id String @id @default(cuid())
  professionalId String
  professional Professional @relation(fields:[professionalId],references:[id],onDelete:Cascade)
  weekday Int
  startMinute Int
  endMinute Int
  enabled Boolean @default(true)
  @@unique([professionalId,weekday])
}
model Appointment {
  id String @id @default(cuid())
  reference String @unique @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  professionalId String
  professional Professional @relation(fields:[professionalId],references:[id])
  serviceId String
  service Service @relation(fields:[serviceId],references:[id])
  clientName String
  clientPhone String
  startAt DateTime
  endAt DateTime
  source BookingSource @default(ONLINE)
  status BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(AT_SHOP)
  amountCents Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([professionalId,startAt,endAt])
  @@index([shopId,startAt])
}
model Expense {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  description String
  amountCents Int
  spentAt DateTime @default(now())
}
model Review {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  clientName String
  rating Int @default(5)
  message String
  photoUrl String @default("")
  approved Boolean @default(false)
  createdAt DateTime @default(now())
}
model Media {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  url String
  caption String @default("")
  type String @default("IMAGE")
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields:[actorId],references:[id])
  shopId String?
  shop Barbershop? @relation(fields:[shopId],references:[id])
  event String
  createdAt DateTime @default(now())
  @@index([shopId,createdAt])
}
