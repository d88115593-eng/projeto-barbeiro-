generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  MASTER
  OWNER
}
enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum PaymentStatus {
  PENDING
  PAID
}
enum PaymentMethod {
  AT_SHOP
  PIX
  CASH
  CARD
}
enum BookingSource {
  ONLINE
  WALK_IN
}
model Barbershop {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String @default("")
  heroTitle String @default("Seu estilo começa aqui.")
  heroSubtitle String @default("")
  showServices Boolean @default(true)
  showTeam Boolean @default(true)
  showGallery Boolean @default(true)
  showReviews Boolean @default(true)
  logoUrl String @default("")
  logoStyle String @default("CARD")
  pixRecipientName String @default("")
  coverUrl String @default("")
  accentColor String @default("#2563FF")
  address String @default("")
  whatsapp String @default("")
  instagram String @default("")
  timezone String @default("America/Bahia")
  pixKey String @default("")
  pixEnabled Boolean @default(false)
  payAtShopEnabled Boolean @default(true)
  status ShopStatus @default(PENDING)
  planDays Int @default(30)
  paidThrough DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  professionals Professional[]
  services Service[]
  appointments Appointment[]
  expenses Expense[]
  reviews Review[]
  media Media[]
  audits AuditLog[]
  blockedDates BlockedDate[]
}
model User {
  id String @id @default(cuid())
  username String @unique
  fullName String @default("")
  email String @default("")
  phone String @default("")
  mustChangePassword Boolean @default(false)
  passwordHash String
  role Role @default(OWNER)
  shopId String?
  shop Barbershop? @relation(fields:[shopId],references:[id],onDelete:SetNull)
  sessions Session[]
  logs AuditLog[]
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model Professional {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  name String
  photoUrl String @default("")
  commissionPct Int @default(50)
  slotIntervalMinutes Int @default(30)
  maxDailyBookings Int @default(0)
  active Boolean @default(true)
  hours WorkingHour[]
  blockedDates BlockedDate[]
  bookings Appointment[]
  @@index([shopId])
}
model Service {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  name String
  description String @default("")
  priceCents Int
  durationMinutes Int
  active Boolean @default(true)
  bookings Appointment[]
  @@index([shopId])
}
model WorkingHour {
  id String @id @default(cuid())
  professionalId String
  professional Professional @relation(fields:[professionalId],references:[id],onDelete:Cascade)
  weekday Int
  startMinute Int
  endMinute Int
  enabled Boolean @default(true)
  @@unique([professionalId,weekday])
}
model BlockedDate {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  professionalId String?
  professional Professional? @relation(fields:[professionalId],references:[id],onDelete:Cascade)
  date String
  note String @default("")
  createdAt DateTime @default(now())
  @@index([shopId,date])
}
model Appointment {
  id String @id @default(cuid())
  reference String @unique @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  professionalId String
  professional Professional @relation(fields:[professionalId],references:[id])
  serviceId String
  service Service @relation(fields:[serviceId],references:[id])
  clientName String
  clientPhone String
  startAt DateTime
  endAt DateTime
  source BookingSource @default(ONLINE)
  status BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(AT_SHOP)
  amountCents Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([professionalId,startAt,endAt])
  @@index([shopId,startAt])
}
model Expense {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  description String
  amountCents Int
  spentAt DateTime @default(now())
}
model Review {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  clientName String
  rating Int @default(5)
  message String
  photoUrl String @default("")
  approved Boolean @default(false)
  createdAt DateTime @default(now())
}
model Media {
  id String @id @default(cuid())
  shopId String
  shop Barbershop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  url String
  caption String @default("")
  type String @default("IMAGE")
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields:[actorId],references:[id])
  shopId String?
  shop Barbershop? @relation(fields:[shopId],references:[id])
  event String
  createdAt DateTime @default(now())
  @@index([shopId,createdAt])
}

model PlatformSettings {
  id String @id @default("main")
  salesHeadline String @default("Seu talento. Seu próximo nível.")
  salesSubtitle String @default("Agenda online, site próprio e gestão financeira em uma plataforma feita para barbearias que querem crescer.")
  salesEyebrow String @default("A EVOLUÇÃO DA SUA BARBEARIA")
  salesCta String @default("Começar agora")
  salesEnabled Boolean @default(true)
  planMonthlyCents Int @default(1990)
  planQuarterlyCents Int @default(2990)
  planSemiannualCents Int @default(5990)
  salesPixKey String @default("")
  salesPixRecipient String @default("")
  salesPixEnabled Boolean @default(false)
  salesPaymentProvider String @default("MANUAL")
  salesGatewayCheckoutUrl String @default("")
  salesTestimonial1 String @default("")
  salesTestimonial2 String @default("")
  salesTestimonial3 String @default("")
  supportWhatsapp String @default("")
  supportEmail String @default("")
  supportMessage String @default("Precisa de ajuda com a BARBERNEX? Fale com nossa equipe.")
  updatedAt DateTime @updatedAt
}
